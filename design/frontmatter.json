{
  "$comment": "Maps DESIGN.md front-matter keys onto src/styles/tokens.css. Run `pnpm design:tokens` after editing either file; never edit the front-matter by hand. Colors: `name` reads --gdg-name (or --name when it already starts with gdg-) from :root, `name-dark` reads --gdg-name from .dark. Other strings that start with --gdg- read that token (`*N` multiplies a px value); anything else is a documented value with no CSS token.",
  "header": {
    "version": "alpha",
    "name": "GDG Apps UI",
    "description": "A private React 19 design system for GDG Apps, built around calm clay surfaces, semantic tokens, accessible Radix interactions, and restrained motion."
  },
  "colors": [
    "white",
    "white-2",
    "black",
    "black-2",
    "primary",
    "on-primary",
    "primary-hover",
    "secondary",
    "on-secondary",
    "secondary-hover",
    "gdg-red",
    "gdg-green",
    "gdg-yellow",
    "background",
    "background-dark",
    "surface",
    "surface-dark",
    "text",
    "text-dark",
    "muted",
    "muted-dark",
    "border",
    "border-dark",
    "input-border",
    "input-border-dark",
    "link",
    "link-dark",
    "focus",
    "focus-dark",
    "selected",
    "selected-dark",
    "neutral",
    "neutral-dark",
    "hover",
    "hover-dark",
    "danger",
    "danger-dark",
    "on-danger",
    "on-danger-dark",
    "danger-surface",
    "danger-surface-dark",
    "success",
    "success-dark",
    "success-surface",
    "success-surface-dark",
    "warning",
    "warning-dark",
    "warning-surface",
    "warning-surface-dark",
    "overlay"
  ],
  "typography": {
    "display": {
      "fontFamily": "--gdg-font-sans",
      "fontSize": "--gdg-text-2xl",
      "fontWeight": "--gdg-weight-heading",
      "lineHeight": "--gdg-leading-tight"
    },
    "heading-md": {
      "fontFamily": "--gdg-font-sans",
      "fontSize": "--gdg-text-xl",
      "fontWeight": "--gdg-weight-heading",
      "lineHeight": "--gdg-leading-tight"
    },
    "heading-sm": {
      "fontFamily": "--gdg-font-sans",
      "fontSize": "--gdg-text-lg",
      "fontWeight": "--gdg-weight-heading",
      "lineHeight": "--gdg-leading-tight"
    },
    "body-md": {
      "fontFamily": "--gdg-font-sans",
      "fontSize": "--gdg-text-md",
      "fontWeight": 400,
      "lineHeight": "--gdg-leading-normal"
    },
    "body-sm": {
      "fontFamily": "--gdg-font-sans",
      "fontSize": "--gdg-text-sm",
      "fontWeight": 400,
      "lineHeight": "--gdg-leading-normal"
    },
    "label": {
      "fontFamily": "--gdg-font-sans",
      "fontSize": "--gdg-text-sm",
      "fontWeight": "--gdg-weight-medium",
      "lineHeight": "--gdg-leading-normal"
    },
    "caption": {
      "fontFamily": "--gdg-font-sans",
      "fontSize": "--gdg-text-xs",
      "fontWeight": 400,
      "lineHeight": "--gdg-leading-normal"
    },
    "control": {
      "fontFamily": "--gdg-font-sans",
      "fontSize": "--gdg-text-sm",
      "fontWeight": "--gdg-weight-medium",
      "lineHeight": 1.4
    },
    "inline-code": {
      "fontFamily": "ui-monospace, SFMono-Regular, Menlo, monospace",
      "fontSize": "0.9em",
      "fontWeight": 400,
      "lineHeight": "--gdg-leading-normal"
    }
  },
  "rounded": {
    "none": "0px",
    "sm": "--gdg-radius-sm",
    "control": "--gdg-radius-md",
    "card": "--gdg-radius-card",
    "dialog": "--gdg-radius-dialog",
    "pill": "9999px",
    "circle": "9999px"
  },
  "spacing": {
    "base": "--gdg-space",
    "xs": "--gdg-space*1",
    "sm": "--gdg-space*2",
    "md": "--gdg-space*3",
    "lg": "--gdg-space*4",
    "xl": "--gdg-space*6",
    "2xl": "--gdg-space*8",
    "3xl": "--gdg-space*12",
    "control": "--gdg-control-height",
    "touch": "--gdg-control-touch",
    "sidebar-width": "--gdg-sidebar-width",
    "page-max": "--gdg-page-width"
  },
  "components": {
    "button-primary": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.on-primary}",
      "typography": "{typography.control}",
      "rounded": "{rounded.control}",
      "height": "{spacing.control}",
      "padding": "8px 16px"
    },
    "button-secondary": {
      "backgroundColor": "{colors.secondary}",
      "textColor": "{colors.on-secondary}",
      "typography": "{typography.control}",
      "rounded": "{rounded.control}",
      "height": "{spacing.control}",
      "padding": "8px 16px"
    },
    "button-outline": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.text}",
      "typography": "{typography.control}",
      "rounded": "{rounded.control}",
      "height": "{spacing.control}",
      "padding": "8px 16px"
    },
    "button-ghost": {
      "backgroundColor": "transparent",
      "textColor": "{colors.text}",
      "typography": "{typography.control}",
      "rounded": "{rounded.control}",
      "height": "{spacing.control}"
    },
    "button-danger": {
      "backgroundColor": "{colors.danger}",
      "textColor": "{colors.on-danger}",
      "typography": "{typography.control}",
      "rounded": "{rounded.control}",
      "height": "{spacing.control}"
    },
    "card": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.text}",
      "rounded": "{rounded.card}",
      "padding": "24px"
    },
    "input": {
      "backgroundColor": "{colors.background}",
      "textColor": "{colors.text}",
      "typography": "{typography.body-sm}",
      "rounded": "{rounded.control}",
      "height": "{spacing.control}",
      "padding": "8px 12px"
    },
    "popup": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.text}",
      "typography": "{typography.body-sm}",
      "rounded": "{rounded.control}",
      "padding": "6px"
    },
    "dialog": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.text}",
      "rounded": "{rounded.dialog}",
      "padding": "32px"
    },
    "badge": {
      "backgroundColor": "{colors.neutral}",
      "textColor": "{colors.text}",
      "typography": "{typography.caption}",
      "rounded": "{rounded.pill}"
    }
  }
}
